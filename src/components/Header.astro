---
import { profile } from '../data/profile';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Stories', href: '/stories/', active: pathname.startsWith('/stories') },
  { label: 'Products', href: '/#products', active: false },
  { label: 'Experience', href: '/experience/', active: pathname.startsWith('/experience') },
];
const externalLinks = profile.links.filter((link) => link.label === 'LinkedIn');
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="Hyeonho Lee 홈">Hyeonho Lee</a>
    <nav aria-label="주요 탐색">
      <ul class="site-nav">
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        {externalLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label}<span class="sr-only"> (새 창)</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
